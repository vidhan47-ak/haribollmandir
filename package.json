{
  "name": "hariboll-mandir",
  "version": "1.0.0",
  "private": true,
  "description": "Sree Chaitanya Mahaprabhu Sree Radha Madhav Mandir (Hariboll Mandir), Jalandhar - Devotional Website",
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "start": "next start",
    "lint": "next lint",
    "dev:vinext": "vinext dev --port 3001",
